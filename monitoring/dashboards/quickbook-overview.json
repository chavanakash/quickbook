        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Booking funnel (per minute)",
      "description": "Searches -> bookings created -> bookings paid, split by flight/train.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (rate(quickbook_searches_total[$__rate_interval])) * 60",
          "legendFormat": "searches {{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (mode) (rate(quickbook_bookings_created_total[$__rate_interval])) * 60",
          "legendFormat": "created {{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (mode) (rate(quickbook_bookings_confirmed_total[$__rate_interval])) * 60",
          "legendFormat": "confirmed {{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Payments & tickets (per minute)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(quickbook_payments_total[$__rate_interval])) * 60",
          "legendFormat": "payment {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(quickbook_tickets_generated_total[$__rate_interval])) * 60",
          "legendFormat": "tickets downloaded",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
